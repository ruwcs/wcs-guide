# Внешний адрес сайта
BASE_URL=http://127.0.0.1:8080

# Путь к базе данных SQLite
DB_PATH=./data/wcs-guide.db

# Идентификатор приложения Telegram
TELEGRAM_API_ID=

# Секрет приложения Telegram
TELEGRAM_API_HASH=

# Токен бота Telegram
TELEGRAM_BOT_TOKEN=

# Путь к файлу сессии Telegram.
TELEGRAM_SESSION_PATH=./data/telegram-bot.session

# Интервал автоматического обновления в минутах.
REFRESH_INTERVAL=10

# Адрес редакторского интерфейса.
EDITOR_BASE_URL=http://localhost:8080
